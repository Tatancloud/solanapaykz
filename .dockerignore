# Правка финального ревью (задача 9, tilda-server): не было ни одного
# .dockerignore, и сборка образа `tilda-server/Dockerfile` (контекст —
# корень репозитория, см. заголовок этого файла и docker-compose.yml)
# отправляла демону Docker весь репозиторий целиком — обе `node_modules`
# (устанавливаются заново внутри образа), `.git`, демо-магазин WordPress
# и прочее, никак не нужное этому образу. Сам Dockerfile копирует внутрь
# только конкретные подкаталоги (`COPY src ./src` и т. п.), поэтому в
# СЛОИ образа лишнее не попадало — но контекст сборки раздувался на
# сотни мегабайт и заметно на каждой пересборке.

# Ставится заново внутри образа (`npm install`), никогда не берётся
# готовым из хоста — версии могут не совпадать по платформе (хост — не
# обязательно linux/alpine, как итоговый образ).
node_modules
**/node_modules

# Пересобирается внутри образа (`npm run build`) в каждом из двух пакетов.
dist
**/dist
tilda-server/dist

# История репозитория образу не нужна вовсе.
.git
.gitignore

# Секреты и локальные данные — не должны попасть в контекст сборки ни при
# каких обстоятельствах, даже если Dockerfile сейчас их не копирует явно:
# один случайный `COPY . .` в будущей правке не должен тихо запечь секрет
# в слой образа.
tilda-server/config.json
tilda-server/data

# Другой проект на этом же хосте (WordPress-плагин и демо-магазин) — не
# часть этого образа вовсе.
demo-shop

# Документация и планирование ревью — не нужны рантайму.
docs
.superpowers
README.md
tilda-server/README.md
*.md
