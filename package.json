{
  "name": "@solanapaykz/core",
  "version": "0.1.0",
  "description": "SDK для приёма платежей в USDC/SOL с конвертацией из тенге",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-program/memo": "0.11.2",
    "@solana-program/system": "0.12.2",
    "@solana-program/token": "0.12.0",
    "@solana-program/token-2022": "0.9.0",
    "@solana/kit": "6.10.0",
    "@solana/pay": "1.0.26",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
