#: solanapaykz.php:103
msgid "SolanaPay-KZ cannot be activated"
msgstr "SolanaPay-KZ не может быть включён"

#: solanapaykz.php:105
msgid "Contact your hosting provider."
msgstr "Обратитесь к вашему хостинг-провайдеру."

#: solanapaykz.php:123
msgid "SolanaPay-KZ disabled:"
msgstr "SolanaPay-KZ отключён:"

#: solanapaykz.php:134
msgid "this plugin requires WooCommerce to be installed and active."
msgstr "плагин требует установленный и включённый WooCommerce."

#: includes/Environment.php:30
#, php-format
msgid "PHP %1$s or newer is required, %2$s is installed."
msgstr "Требуется PHP %1$s или новее, установлен %2$s."

#: includes/Environment.php:40
#, php-format
msgid "The PHP extension \"%s\" is not installed."
msgstr "Не установлено расширение PHP «%s»."

#: includes/Gateway.php:30
msgid "Accept cryptocurrency payments on the Solana blockchain, automatically converted from tenge. Funds go directly to the merchant's wallet."
msgstr "Приём оплаты в криптовалюте на блокчейне Solana с автоматическим пересчётом из тенге. Деньги идут напрямую на кошелёк продавца."

#: includes/Gateway.php:40 includes/GatewaySettings.php:285
#: includes/BlocksSupport.php:89
msgid "Pay with cryptocurrency (USDC)"
msgstr "Оплата криптовалютой (USDC)"

#: includes/Gateway.php:73
msgid "SolanaPay-KZ has been disabled until the settings are corrected."
msgstr "SolanaPay-KZ выключен, пока настройки не исправлены."

#: includes/Gateway.php:120
msgid "Could not find the order to pay for. Please try checking out again."
msgstr "Не удалось найти заказ для оплаты. Попробуйте оформить заказ заново."

#: includes/Gateway.php:166
msgid "Cryptocurrency payment is currently unavailable: could not fetch the exchange rate. Please choose another payment method."
msgstr "Оплата криптовалютой сейчас недоступна: не удалось получить курс. Выберите другой способ оплаты."

#: includes/Gateway.php:177
msgid "Could not prepare the cryptocurrency payment. Please choose another method."
msgstr "Не удалось подготовить оплату криптовалютой. Выберите другой способ."

#: includes/Gateway.php:200
#, php-format
msgid "Awaiting payment of %1$s %2$s. Rate %3$s from \"%4$s\"."
msgstr "Ожидается оплата %1$s %2$s. Курс %3$s от «%4$s»."

#: includes/Gateway.php:248
msgid "Could not load the payment data. Please contact the store."
msgstr "Не удалось загрузить данные оплаты. Свяжитесь с магазином."

#: includes/Gateway.php:270
#, php-format
msgid "The payment window for this order has expired (the price was valid until %s). Please check out again."
msgstr "Срок оплаты этого заказа истёк (цена действовала до %s). Оформите заказ заново."

#: includes/Gateway.php:290
#, php-format
msgid "Order #%s"
msgstr "Заказ №%s"

#: includes/Gateway.php:302
msgid "Payment is temporarily unavailable, please contact the seller."
msgstr "Оплата временно недоступна, свяжитесь с продавцом."

#: includes/Gateway.php:374
msgid "Pay with cryptocurrency"
msgstr "Оплата криптовалютой"

#: includes/Gateway.php:377
msgid "Amount due:"
msgstr "К оплате:"

#: includes/Gateway.php:380
msgid "at rate"
msgstr "по курсу"

#: includes/Gateway.php:386
msgid "Scan the code with a Solana wallet. Funds go directly to the seller."
msgstr "Отсканируйте код кошельком Solana. Деньги придут продавцу напрямую."

#: includes/Gateway.php:392
msgid "Awaiting payment…"
msgstr "Ожидаем оплату…"

#: includes/Gateway.php:396
msgid "Open in wallet on this device"
msgstr "Открыть в кошельке на этом устройстве"

#: includes/Gateway.php:402
msgid "JavaScript is disabled in your browser: the QR code and payment status will not appear, and the page will not refresh itself after payment. You can still send the payment using the \"Open in wallet\" link above — refresh this page manually after paying to see its current status."
msgstr "В браузере отключён JavaScript: код QR и статус оплаты не отобразятся, а страница не обновится сама после оплаты. Платёж всё равно можно отправить по ссылке «Открыть в кошельке» выше — после оплаты обновите эту страницу вручную, чтобы увидеть её текущий статус."

#: includes/GatewaySettings.php:100
#, php-format
msgid "This plugin is designed for stores priced in tenge, because the exchange rate is quoted in tenge. Your store currency is currently \"%s\"."
msgstr "Плагин рассчитан на магазины с ценами в тенге, потому что курс берётся к тенге. Валюта вашего магазина сейчас — «%s»."

#: includes/GatewaySettings.php:112
msgid "Choose a network: mainnet or devnet (test network)."
msgstr "Выберите сеть: основную или тестовую."

#: includes/GatewaySettings.php:117
#, php-format
msgid "Coin \"%s\" is not supported."
msgstr "Монета «%s» не поддерживается."

#: includes/GatewaySettings.php:131
msgid "Quote lifetime"
msgstr "Срок жизни котировки"

#: includes/GatewaySettings.php:138
msgid "Cancelled order check window"
msgstr "Срок проверки отменённых заказов"

#: includes/GatewaySettings.php:150
msgid "Enter the Solana wallet address that will receive payments."
msgstr "Укажите адрес кошелька Solana, на который будут приходить платежи."

#: includes/GatewaySettings.php:159
msgid "The wallet address is in the wrong format: only base58 characters are allowed."
msgstr "Адрес кошелька записан не в том формате: допустимы только символы base58."

#: includes/GatewaySettings.php:165
msgid "The wallet address has the wrong length. Check that you copied it in full."
msgstr "Адрес кошелька неверной длины. Проверьте, что скопировали его целиком."

#: includes/GatewaySettings.php:181
msgid "This is the coin's address, not a wallet address. Enter your own wallet address — payments sent to the coin's address cannot be recovered."
msgstr "Это адрес монеты, а не кошелька. Укажите адрес своего кошелька — платежи на адрес монеты вернуть невозможно."

#: includes/GatewaySettings.php:197
msgid "Enter the Solana node URL. A public node is not suitable for accepting payments: it rate-limits requests and does not keep the history needed to find a payment."
msgstr "Укажите адрес узла Solana. Публичный узел для приёма платежей не подходит: он ограничивает запросы и не хранит историю, нужную для поиска платежа."

#: includes/GatewaySettings.php:208
msgid "The node address must start with http:// or https://."
msgstr "Адрес узла должен начинаться с http:// или https://."

#: includes/GatewaySettings.php:218
msgid "Markup must be a number."
msgstr "Наценка должна быть числом."

#: includes/GatewaySettings.php:224
msgid "Markup must be between 0 and 100 percent."
msgstr "Наценка должна быть от 0 до 100 процентов."

#: includes/GatewaySettings.php:231
msgid "A markup smaller than 0.01 percent has no effect. Enter a larger value or zero."
msgstr "Наценка меньше 0,01 процента не применяется. Укажите большее значение или ноль."

#: includes/GatewaySettings.php:244
#, php-format
msgid "%s must be a whole number of seconds."
msgstr "%s должен быть целым числом секунд."

#: includes/GatewaySettings.php:252
#, php-format
msgid "%1$s must be between %2$d and %3$d seconds."
msgstr "%1$s должен быть от %2$d до %3$d секунд."

#: includes/GatewaySettings.php:276
msgid "Enable"
msgstr "Включить"

#: includes/GatewaySettings.php:278
msgid "Accept cryptocurrency payments"
msgstr "Принимать оплату криптовалютой"

#: includes/GatewaySettings.php:282
msgid "Payment method title"
msgstr "Название способа оплаты"

#: includes/GatewaySettings.php:284
msgid "What the customer sees at checkout."
msgstr "Что увидит покупатель при оформлении заказа."

#: includes/GatewaySettings.php:289
msgid "Description"
msgstr "Описание"

#: includes/GatewaySettings.php:292
msgid "Scan the QR code with a Solana wallet. Funds go directly to the seller."
msgstr "Отсканируйте QR-код кошельком Solana. Деньги придут продавцу напрямую."

#: includes/GatewaySettings.php:297
msgid "Merchant wallet address"
msgstr "Адрес кошелька продавца"

#: includes/GatewaySettings.php:300
msgid "The Solana address that will receive payments. This is your wallet address, not the coin address."
msgstr "Адрес Solana, на который придут платежи. Это адрес вашего кошелька, а не адрес монеты."

#: includes/GatewaySettings.php:308
msgid "Network"
msgstr "Сеть"

#: includes/GatewaySettings.php:311
msgid "Mainnet (real money)"
msgstr "Основная сеть (настоящие деньги)"

#: includes/GatewaySettings.php:312
msgid "Devnet (free test coins)"
msgstr "Тестовая сеть (бесплатные монеты, для проверки)"

#: includes/GatewaySettings.php:316
msgid "Start on the test network and switch to mainnet once you've confirmed everything works."
msgstr "Начните с тестовой сети и переключитесь на основную, когда убедитесь, что всё работает."

#: includes/GatewaySettings.php:322
msgid "Solana node URL"
msgstr "Адрес узла Solana"

#: includes/GatewaySettings.php:325
msgid "A public node is not suitable: it rate-limits requests and does not keep the history needed to find a payment. You need your own provider."
msgstr "Публичный узел не подходит: он ограничивает запросы и не хранит историю, нужную для поиска платежа. Нужен собственный провайдер."

#: includes/GatewaySettings.php:333
msgid "Coin"
msgstr "Монета"

#: includes/GatewaySettings.php:335
msgid "USDC (stablecoin)"
msgstr "USDC (стейблкоин)"

#: includes/GatewaySettings.php:339
msgid "Markup, %"
msgstr "Наценка, %"

#: includes/GatewaySettings.php:342
msgid "Added to the order total before converting to cryptocurrency. Insurance against the rate moving while the customer is paying."
msgstr "Добавляется к сумме заказа до пересчёта в криптовалюту. Страховка от движения курса, пока покупатель платит."

#: includes/GatewaySettings.php:350
msgid "Price validity, seconds"
msgstr "Срок действия цены, секунд"

#: includes/GatewaySettings.php:353
msgid "How long the locked-in rate stays valid. 15 minutes by default."
msgstr "Сколько времени действует зафиксированный курс. По умолчанию 15 минут."

#: includes/GatewaySettings.php:360
msgid "Check cancelled orders for, seconds"
msgstr "Проверять отменённые заказы, секунд"

#: includes/GatewaySettings.php:363
msgid "Cancelling an order does not cancel its QR code: the customer may still pay later. For this long, the plugin keeps checking cancelled orders and warns you about a late payment. Zero disables the check."
msgstr "Отмена заказа не отменяет QR-код: покупатель может заплатить позже. В течение этого времени плагин продолжит проверять отменённые заказы и предупредит вас о позднем платеже. Ноль отключает проверку."

#: includes/GatewaySettings.php:391 includes/GatewaySettings.php:402
msgid "Plugin status"
msgstr "Статус плагина"

#: includes/GatewaySettings.php:394
#, php-format
msgid "Store currency: <strong>%s</strong> — the plugin works."
msgstr "Валюта магазина: <strong>%s</strong> — плагин работает."

#: includes/GatewaySettings.php:406
#, php-format
msgid "Store currency: <strong>%s</strong> — the plugin is disabled. The exchange rate is quoted in tenge, so the store must price in tenge. Change the currency in WooCommerce settings: Settings → General → Currency."
msgstr "Валюта магазина: <strong>%s</strong> — плагин отключён. Курс берётся к тенге, поэтому нужен магазин с ценами в тенге. Смените валюту в настройках WooCommerce: Настройки → Основные → Валюта."

#: includes/CustomerMessage.php:47
msgid "Awaiting payment."
msgstr "Ожидаем оплату."

#: includes/CustomerMessage.php:51 includes/CustomerMessage.php:108
msgid "Payment received. Thank you!"
msgstr "Оплата получена. Спасибо!"

#: includes/CustomerMessage.php:57
msgid "The order has been paid and refunded. If you still have questions, please contact the store."
msgstr "Заказ оплачен и возвращён. Если у вас остались вопросы, напишите в магазин."

#: includes/CustomerMessage.php:66
msgid "The payment window has expired, the order has been cancelled."
msgstr "Срок оплаты истёк, заказ отменён."

#: includes/CustomerMessage.php:72
msgid "The payment is being verified manually. The seller will contact you."
msgstr "Платёж проверяется вручную. Продавец свяжется с вами."

#: includes/CustomerMessage.php:84
msgid "Cryptocurrency payment for this order is currently unavailable. Please contact the store."
msgstr "Оплата криптовалютой для этого заказа сейчас недоступна. Свяжитесь с магазином."

#: includes/CustomerMessage.php:111
msgid "The payment window has expired. Please check out again."
msgstr "Срок оплаты истёк. Оформите заказ заново."

#: includes/CustomerMessage.php:116
msgid "A payment was found, but it did not match the order amount. The store will contact you."
msgstr "Платёж найден, но не сошёлся с суммой заказа. Магазин свяжется с вами."

#: includes/CustomerMessage.php:123
msgid "The payment was received after the order was cancelled. The store will contact you."
msgstr "Платёж получен после отмены заказа. Магазин свяжется с вами."

#: includes/OrderChecker.php:32
msgid "Payment data is corrupted, automatic verification is not possible. The store will contact you."
msgstr "Данные оплаты повреждены, автоматическая проверка невозможна. Магазин свяжется с вами."

#: includes/OrderChecker.php:40
msgid "Could not verify the payment. We will try again."
msgstr "Не удалось проверить оплату. Пробуем ещё раз."

#: includes/OrderChecker.php:122
msgid "SolanaPay-KZ: could not read the payment data (the quote, payment reference, or recipient address is missing or corrupted). Automatic verification is not possible — this order's payment needs to be checked manually."
msgstr "SolanaPay-KZ: не удалось прочитать данные оплаты (котировка, метка платежа или адрес получателя повреждены либо отсутствуют). Автоматическая проверка невозможна — оплату этого заказа нужно проверить вручную."

#: includes/OrderChecker.php:196 includes/Ajax.php:48
msgid "Order not found."
msgstr "Заказ не найден."

#: includes/Ajax.php:52
msgid "This order is being paid by another method."
msgstr "Заказ оплачивается другим способом."

#: includes/Ajax.php:86
msgid "Payment method unavailable."
msgstr "Способ оплаты недоступен."

#: includes/PaymentDecision.php:61
#, php-format
msgid "Payment received. Transaction: %1$s. Expected: %2$s %3$s. Received: %4$s %5$s."
msgstr "Платёж получен. Транзакция: %1$s. Ожидалось: %2$s %3$s. Получено: %4$s %5$s."

#: includes/PaymentDecision.php:79
#, php-format
msgid "Found transaction %1$s, but it failed verification: %2$s Please check it manually before shipping the order."
msgstr "Найдена транзакция %1$s, но она не прошла проверку: %2$s Проверьте её вручную, прежде чем отгружать заказ."

#: includes/PaymentDecision.php:84
msgid "no reason given."
msgstr "причина не указана."

#: includes/PaymentDecision.php:98
#, php-format
msgid "Payment window expired: the price was locked until %s."
msgstr "Срок оплаты истёк: цена была зафиксирована до %s."

#: includes/PaymentDecision.php:128
#, php-format
msgid "Warning: a payment was received for a cancelled order. Transaction: %1$s. Expected: %2$s %3$s. Received: %4$s %5$s. Decide whether to restore the order or refund the customer."
msgstr "Внимание: на отменённый заказ пришёл платёж. Транзакция: %1$s. Ожидалось: %2$s %3$s. Получено: %4$s %5$s. Решите, восстановить заказ или вернуть деньги покупателю."

#: includes/Scheduler.php:33
msgid "Every 5 minutes (SolanaPay-KZ)"
msgstr "Каждые 5 минут (SolanaPay-KZ)"

#: includes/Scheduler.php:72
msgid "The site has the built-in WordPress pseudo-cron disabled (the DISABLE_WP_CRON constant). Without a real system cron on wp-cron.php, the background payment check will never run — payment confirmation will only work while the customer keeps the payment tab open."
msgstr "На сайте отключён встроенный псевдо-cron WordPress (константа DISABLE_WP_CRON). Без настоящего системного cron на wp-cron.php фоновая проверка оплаты не сработает никогда — подтверждение платежа будет работать только пока покупатель держит вкладку с оплатой открытой."

#: includes/Verify.php:150
msgid "The blockchain node's response does not include a transaction outcome (meta.err is missing)."
msgstr "Ответ узла не содержит признака результата транзакции (meta.err отсутствует)."

#: includes/Verify.php:157
msgid "The transaction failed with an error."
msgstr "Транзакция завершилась с ошибкой."

#: includes/Verify.php:171
msgid "The transaction does not contain the payment reference."
msgstr "В транзакции нет метки платежа."

#: includes/Verify.php:187
msgid "The transaction does not contain a SOL transfer to the expected recipient."
msgstr "В транзакции нет перевода SOL нужному получателю."

#: includes/Verify.php:189
msgid "The transaction does not contain a transfer of the expected token to the expected recipient."
msgstr "В транзакции нет перевода нужного токена нужному получателю."

#: includes/Verify.php:198
#, php-format
msgid "Amount is less than expected: received %1$s, required %2$s."
msgstr "Сумма меньше ожидаемой: получено %1$s, требуется %2$s."

#: assets/checkout.js:65
msgid "QR code for payment via a Solana wallet"
msgstr "QR-код для оплаты через кошелёк Solana"

#: assets/checkout.js:77
msgid "Price valid for another "
msgstr "Цена действует ещё "

#: assets/checkout.js:87
msgid "The price has expired. If you already sent the payment, please wait for confirmation — this can take up to a minute."
msgstr "Срок цены истёк. Если вы уже отправили платёж, дождитесь подтверждения — это занимает до минуты."

#: assets/checkout.js:92
msgid "The payment window has expired. If you did send the payment, please contact the store."
msgstr "Срок оплаты истёк. Если вы всё же отправили платёж, свяжитесь с магазином."

#: assets/checkout.js:176
msgid "Automatic payment verification is not available in this browser. Please refresh the page manually after paying."
msgstr "Автоматическая проверка оплаты недоступна в этом браузере. Обновите страницу вручную после оплаты."
