# Образ сервера приёма оплаты для Tilda.
#
# Контекст сборки — КОРЕНЬ РЕПОЗИТОРИЯ (см. docker-compose.yml, "context: .."),
# а не сам каталог tilda-server: пакет ссылается на @solanapaykz/core записью
# "file:.." в package.json, а npm разрешает такую зависимость СИМЛИНКОМ на
# соседний каталог (node_modules/@solanapaykz/core -> ../../..), а не копией.
# Поэтому оба пакета собираются в одном образе, по одному и тому же пути
# /app, и в финальный образ переносится дерево /app целиком — выборочное
# копирование одних подкаталогов без других оставило бы этот симлинк
# висящим в пустоте.
#
# Версия базового образа закреплена по минорной версии (22.23), а не просто
# "node:22-alpine" — находка ревью: `node:22-alpine` тянет свежий патч при
# каждой пересборке без единой правки в репозитории. Опасно это не само по
# себе, а из-за флага ниже: `node:sqlite` был экспериментальным модулем под
# флагом `--experimental-sqlite` вплоть до Node 22.13 (см. src/db.ts) — на
# 22.5-22.12 без флага модуль вообще не существует
# (ERR_UNKNOWN_BUILTIN_MODULE), проверено на живых образах node:22.5-alpine
# и node:22.12-alpine. Начиная с 22.13 флаг стал необязателен, и сам Node
# отвергает НАСТОЯЩИЙ несуществующий флаг немедленным выходом — если
# `--experimental-sqlite` из CMD ниже когда-нибудь снова станет обязательным
# (модуль дойдёт до стабильного статуса и флаг уберут как ключевой), контейнер
# начнёт падать на старте по кругу, а `docker compose up -d` бы этого не
# заметил. Закреплённая версия убирает саму возможность такого сюрприза без
# ведома репозитория; при сознательном обновлении версии — сначала проверить
# `node:sqlite` на новом образе так же, как проверено здесь.
FROM node:22.23.2-alpine AS build
WORKDIR /app

# --- корневой SDK (@solanapaykz/core) ---
COPY package.json package-lock.json tsconfig.json tsup.config.ts ./
COPY src ./src
# npm ci, а не npm install: ci сверяет package.json с package-lock.json и
# ОТКАЗЫВАЕТСЯ при расхождении, install в этом случае молча ставит версию
# из package.json и переписывает замок ПРЯМО ВНУТРИ ОБРАЗА — тогда в
# репозитории лежит один набор версий, а в собранном образе другой, и
# увидеть это неоткуда: тесты в CI гоняются по package-lock.json
# репозитория, а не по тому, что реально попало в слой образа. Проверено
# ревью: подмена версии в package.json без правки замка — npm ci падает
# сразу, npm install проходит и переписывает lock.
RUN npm ci --include=dev
RUN npm run build

# --- tilda-server ---
WORKDIR /app/tilda-server
COPY tilda-server/package.json tilda-server/package-lock.json tilda-server/tsconfig.json ./
COPY tilda-server/src ./src
COPY tilda-server/public ./public
# npm ci создаёт node_modules/@solanapaykz/core -> ../../.. только после
# того, как в /app уже лежит package.json корневого пакета (см. выше) —
# порядок шагов этого файла важен. Проверено ревью: npm ci корректно
# разрешает зависимость "file:.." символической ссылкой на соседний
# каталог (не копией), как и npm install.
RUN npm ci --include=dev
RUN npm run build

# Урезаем dev-зависимости в обоих пакетах перед переносом в финальный образ —
# компиляторы (tsc, tsup) и vitest самому процессу в бою не нужны.
#
# Порядок здесь важен, и он обратный очевидному. Корневой пакет имеет скрипт
# `prepare` — он нужен, чтобы библиотека собиралась при установке прямо из
# git-репозитория (см. package.json). Урезание зависимостей в tilda-server
# заново связывает зависимость "file:.." и запускает этот `prepare`. Если к
# тому моменту корневой пакет уже урезан, tsup удалён, и сборка падает с
# «tsup: not found» — на шаге, который ничего собирать не должен. Флаг
# --ignore-scripts эту вложенную сборку не останавливает, проверено.
#
# Поэтому сначала урезаем tilda-server (пока корневой пакет цел и `prepare`
# отрабатывает), и только потом сам корневой пакет.
WORKDIR /app/tilda-server
RUN npm prune --omit=dev
WORKDIR /app
RUN npm prune --omit=dev --ignore-scripts

FROM node:22.23.2-alpine
ENV NODE_ENV=production
WORKDIR /app/tilda-server

# Копируем ВЕСЬ /app целиком, а не отдельные подкаталоги — см. комментарий
# в начале файла про симлинк file:.. зависимости.
COPY --from=build /app /app

# Каталог для файла SQLite — существует всегда, даже если docker-compose.yml
# не смонтирует сюда именованный том (например, при разовом запуске без
# compose): node:sqlite не создаёт отсутствующие родительские каталоги сам.
RUN mkdir -p /app/tilda-server/data

# Непривилегированный пользователь — правка финального ревью (задача 5).
# Пользователь не был задан вовсе: процесс работал от root, и любая ошибка
# исполнения (в самом Node, в зависимости, в будущем коде) давала бы
# внутри контейнера полные права ровно там, где смонтированы настройки
# (config.json) и база заказов. `node` — встроенный в официальный образ
# непривилегированный пользователь (uid/gid 1000), отдельно заводить
# своего не нужно.
#
# chown только на data/ — она единственная, куда процесс пишет (файл
# SQLite и его -wal/-shm при WAL, см. src/db.ts). Остальное дерево
# (dist, node_modules, config.json смонтированный read-only) процессу
# достаточно читать, а COPY --from=build уже оставляет файлы
# мирочитаемыми по умолчанию.
#
# Само по себе это не чинит уже существующий на хосте именованный том с
# данными — тот заведён ещё под root и по-прежнему принадлежит root на
# диске хоста; на уже развёрнутом стенде владельца тома нужно поменять
# отдельной командой ПЕРЕД перезапуском с этим образом (см. README.md,
# «Развёртывание» — миграция существующего тома под непривилегированного
# пользователя), иначе процесс не сможет писать в свою же базу.
RUN chown -R node:node /app/tilda-server/data
USER node

# Порт по умолчанию из config.ts (ПО_УМОЛЧАНИЮ.listenPort) — реально
# слушаемый порт задаётся config.json → listenPort и может быть другим:
# этот стенд, например, настроен на 8081 (см. docker-compose.yml → ports).
# EXPOSE — только документация для тех, кто читает этот файл, самого
# проброса портов Docker не делает независимо от значения; docker-compose.yml
# публикует наружу тот порт, что реально задан в config.json.
#
# Правка финального ревью (задача 9): раньше здесь стояло «наружу порт
# открывает docker-compose.yml через network_mode: host» — тот режим
# заменили на обычную сеть моста ещё в прошлом круге ревью (см. заголовок
# docker-compose.yml), а комментарий остался и описывал сеть, от которой
# уже отказались.
EXPOSE 8080

# Без --experimental-sqlite: на закреплённой версии (22.23.2, см. FROM
# выше) флаг ничего не решает — node:sqlite доступен по умолчанию с Node
# 22.13. Проверено на этом самом образе: и с флагом, и без него `node:sqlite`
# работает одинаково; при этом настоящий несуществующий флаг Node отвергает
# немедленным выходом (exit 9), а не тихо игнорирует — держать бесполезный
# флаг в команде запуска не бесплатно, случайная будущая правка легко
# прочитает его как «всё ещё обязателен» и унесёт с собой при копировании
# в другое место.
CMD ["node", "dist/http/server.js"]
